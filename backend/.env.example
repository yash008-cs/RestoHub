# Server Port Configuration
PORT=8080

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/restohub?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Spring Mail / SMTP Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# Password Reset OTP Expiry Duration (in minutes)
OTP_EXPIRY_MINUTES=5

# AI Assistant & Chatbot (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Payment Gateway (Optional)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
